//+------------------------------------------------------------------+
void OnTick()
{
   if(g_HardStopHit) return; 

   if(g_DailyStartBalance <= 0)
      g_DailyStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);

   ResetDailyBalance();
   CheckEquityProtection();
   CheckDailyProfitLimit();

   if(g_DailyLimitHit) return;

   ManageTrades();
}

//+------------------------------------------------------------------+
void ResetDailyBalance()
{
   datetime currentDay = iTime(_Symbol, PERIOD_D1, 0);
   if(currentDay != g_LastDayReset)
   {
      g_DailyStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);
      g_LastDayReset      = currentDay;
      g_DailyLimitHit     = false;
   }
}

//+------------------------------------------------------------------+
void CheckEquityProtection()
{
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity  = AccountInfoDouble(ACCOUNT_EQUITY);

   if(equity <= balance - HardStopLossUSC)
   {
      Print("HARD STOP TRIGGERED! Floating loss exceeded ", HardStopLossUSC, " USC. Closing all trades.");
      CloseAllTrades();
      g_HardStopHit = true; 
   }
}

//+------------------------------------------------------------------+
void CheckDailyProfitLimit()
{
   if(g_DailyLimitHit) return; 
   if(g_DailyStartBalance <= 0) return; 

   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity  = AccountInfoDouble(ACCOUNT_EQUITY);
   double profit  = equity - g_DailyStartBalance;

   bool limitHit = false;

   if(DailyProfitMode == PERCENTAGE)
   {
      double pct = (profit / g_DailyStartBalance) * 100.0;
      if(pct >= DailyProfitLimit) limitHit = true;
   }
   else 
   {
      if(profit >= DailyProfitLimit) limitHit = true;
   }

   if(limitHit)
   {
      CloseAllTrades();
      g_DailyLimitHit = true; 
   }
}

//+------------------------------------------------------------------+
bool CheckGlobalHighImpactNews(datetime fromTime, datetime toTime)
{
   MqlCalendarValue values[];
   
   if(CalendarValueHistory(values, fromTime, toTime, NULL, NULL))
   {
      for(int i = 0; i < ArraySize(values); i++)
      {
         MqlCalendarEvent event;
         if(CalendarEventById(values[i].event_id, event))
         {
            if(event.importance == CALENDAR_IMPORTANCE_HIGH)
               return true;
         }
      }
   }
   return false;
}

//+------------------------------------------------------------------+
bool IsNewsTime()
{
   if(!UseNewsFilter) return false;
   
   datetime now = TimeCurrent();
   datetime fromTime = now - (StartMinutesAfterNews * 60);
   datetime toTime   = now + (StopMinutesBeforeNews * 60);
   
   return CheckGlobalHighImpactNews(fromTime, toTime);
}

//+------------------------------------------------------------------+
void ManageTrades()
{
   int total = CountPositions();
   MqlDateTime dtBroker;
   TimeCurrent(dtBroker);

   // --- 1. CALCULATE PURE IST TIME ---
   datetime gmtTime = TimeGMT();
   datetime istTime = gmtTime + (5 * 3600) + (30 * 60); 
   MqlDateTime dtIST;
   TimeToStruct(istTime, dtIST);

   // --- 2. FRIDAY/MONDAY/NEWS HALTS ---
   bool isFridayHalt = false;
   if(UseFridayKillSwitch && dtBroker.day_of_week == 5 && dtBroker.hour >= FridayStopHour)
      isFridayHalt = true;

   bool isMondayHalt = false;
   if(UseMondayDelay && dtBroker.day_of_week == 1 && dtBroker.hour < MondayStartHour)
      isMondayHalt = true;

   bool isNewsActive = IsNewsTime();

   // --- 3. DAILY SLEEP WINDOW (IST Time) ---
   bool isDailyPauseIST = false;
   if(UseDailyPause)
   {
      int currentMinsIST = dtIST.hour * 60 + dtIST.min;
      int startMinsIST   = DailyPauseStartHour * 60 + DailyPauseStartMin;
      int endMinsIST     = DailyPauseEndHour * 60 + DailyPauseEndMin;

      if(startMinsIST > endMinsIST) 
      {
         if(currentMinsIST >= startMinsIST || currentMinsIST < endMinsIST)
            isDailyPauseIST = true;
      }
      else 
      {
         if(currentMinsIST >= startMinsIST && currentMinsIST < endMinsIST)
            isDailyPauseIST = true;
      }
   }

   // --- THE FIX: Combine filters so they ONLY block new cycles ---
   bool blockNewCycle = isFridayHalt || isMondayHalt || isNewsActive || isDailyPauseIST; 

   // --- NEW DIAGNOSTIC LOGIC ---
   if(total == 0)
   {
      // If no trades are open, respect the pauses and news filters
      if(blockNewCycle) 
      {
         static datetime lastBlockLog = 0;
         if(TimeCurrent() - lastBlockLog >= 60) // Prints only once per minute to avoid spam
         {
            Print("EA DIAGNOSTIC: Blocked from NEW trades -> News: ", isNewsActive, " | Sleep: ", isDailyPauseIST, " | Weekend: ", (isFridayHalt || isMondayHalt));
            lastBlockLog = TimeCurrent();
         }
         return;
      }

      double ema[];
      if(CopyBuffer(handleEMA, 0, 0, 1, ema) <= 0) 
      {
         Print("EA DIAGNOSTIC: Cannot read EMA indicator. Waiting for data...");
         return;
      }
      
      double close = iClose(_Symbol, PERIOD_H1, 0);

      if(close > ema[0])
      {
         Print("EA DIAGNOSTIC: Attempting BUY... Price (", close, ") is above EMA (", ema[0], ")");
         OpenTrade(ORDER_TYPE_BUY,  LotSizes[0]);
      }
      else if(close < ema[0])
      {
         Print("EA DIAGNOSTIC: Attempting SELL... Price (", close, ") is below EMA (", ema[0], ")");
         OpenTrade(ORDER_TYPE_SELL, LotSizes[0]);
      }
   }
   else
   {
      // IF A CYCLE IS OPEN: Always manage TP and Grid Averaging (Ignores all pauses)
      CheckBasketProfit(total);
      GridLogic(total);
   }
}

//+------------------------------------------------------------------+
void GridLogic(int total)
{
   if(total >= 100) return;

   double   lastPrice = 0;
   long     lastType  = -1;
   datetime lastTime  = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket))
      {
         if(PositionGetInteger(POSITION_MAGIC) == Magic &&
            PositionGetString(POSITION_SYMBOL) == _Symbol)
         {
            datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
            
            if(openTime > lastTime) 
            {
               lastTime  = openTime;
               lastPrice = PositionGetDouble(POSITION_PRICE_OPEN);
               lastType  = PositionGetInteger(POSITION_TYPE);
            }
         }
      }
   }

   if(lastPrice == 0) return;

   double distance = Distances[total - 1] * _Point;

   if(lastType == POSITION_TYPE_BUY)
   {
      if(SymbolInfoDouble(_Symbol, SYMBOL_BID) < lastPrice - distance)
      {
         Print("EA DIAGNOSTIC: Grid Triggered - Attempting to BUY Leg ", total + 1);
         OpenTrade(ORDER_TYPE_BUY, LotSizes[total]);
      }
   }
   else if(lastType == POSITION_TYPE_SELL)
   {
      if(SymbolInfoDouble(_Symbol, SYMBOL_ASK) > lastPrice + distance)
      {
         Print("EA DIAGNOSTIC: Grid Triggered - Attempting to SELL Leg ", total + 1);
         OpenTrade(ORDER_TYPE_SELL, LotSizes[total]);
      }
   }
}

//+------------------------------------------------------------------+
void CheckBasketProfit(int total)
{
   double totalVolume = 0;
   double totalValue = 0;
   long   gridType = -1;

   for(int i = 0; i < PositionsTotal(); i++)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket))
      {
         if(PositionGetInteger(POSITION_MAGIC) == Magic &&
            PositionGetString(POSITION_SYMBOL) == _Symbol)
         {
            double vol   = PositionGetDouble(POSITION_VOLUME);
            double price = PositionGetDouble(POSITION_PRICE_OPEN);
            
            totalVolume += vol;
            totalValue  += (vol * price);
            
            if(gridType == -1)
               gridType = PositionGetInteger(POSITION_TYPE);
         }
      }
   }

   if(totalVolume == 0 || gridType == -1) return;

   double bePrice = totalValue / totalVolume;
   double targetPoints = (total <= MaxLegsForTP1) ? TP1_Points : TP2_Points;

   // 1. Virtual TP Fallback 
   if(gridType == POSITION_TYPE_BUY)
   {
      double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      if((bid - bePrice) / _Point >= targetPoints) { CloseAllTrades(); return; }
   }
   else if(gridType == POSITION_TYPE_SELL)
   {
      double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      if((bePrice - ask) / _Point >= targetPoints) { CloseAllTrades(); return; }
   }

   // 2. Physical Broker TP 
   double targetPrice = 0;
   if(gridType == POSITION_TYPE_BUY)
      targetPrice = bePrice + (targetPoints * _Point);
   else if(gridType == POSITION_TYPE_SELL)
      targetPrice = bePrice - (targetPoints * _Point);

   targetPrice = NormalizeDouble(targetPrice, _Digits);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket))
      {
         if(PositionGetInteger(POSITION_MAGIC) == Magic && PositionGetString(POSITION_SYMBOL) == _Symbol)
         {
            double currentTP = PositionGetDouble(POSITION_TP);
            
            if(MathAbs(currentTP - targetPrice) > _Point * 0.5)
            {
               double currentSL = PositionGetDouble(POSITION_SL);
               trade.PositionModify(ticket, currentSL, targetPrice);
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
void OpenTrade(ENUM_ORDER_TYPE type, double lot)
{
   bool result = false;
   if(type == ORDER_TYPE_BUY) 
      result = trade.Buy(lot, _Symbol);
   else if(type == ORDER_TYPE_SELL) 
      result = trade.Sell(lot, _Symbol);
      
   if(!result)
   {
      Print("EA DIAGNOSTIC: BROKER REJECTED ORDER! Code: ", trade.ResultRetcode(), " | Description: ", trade.ResultRetcodeDescription());
   }
}

//+------------------------------------------------------------------+
int CountPositions()
{
   int count = 0;
   for(int i = 0; i < PositionsTotal(); i++)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket))
         if(PositionGetInteger(POSITION_MAGIC) == Magic &&
            PositionGetString(POSITION_SYMBOL) == _Symbol)
            count++;
   }
   return count;
}

//+------------------------------------------------------------------+
void CloseAllTrades()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket))
      {
         if(PositionGetInteger(POSITION_MAGIC) == Magic &&
            PositionGetString(POSITION_SYMBOL) == _Symbol)
         {
            trade.PositionClose(ticket);
         }
      }
   }
}
